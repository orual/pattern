name "full-test-plugin"
version "1.0.0"
description "A full-featured test plugin"
homepage "https://example.com"
repository "https://github.com/test/plugin"
license "MIT"

author "Test Author" {
email "test@example.com"
    url "https://example.com/author"
}

keywords "test" "plugin" "example"

skills {
    tool "skills/tool_a.md"
    tool "skills/tool_b.md"
}

commands {
    cmd "bin/my-command"
}

hooks {
    hook "hooks/on-save.js"
}

mcp-servers {
    server "servers/my-mcp"
}

capabilities {
    effects "Memory" "File" "Shell"
}

transport "stdio"

pattern {
    min-version "0.4.0"
}

experimental-feature {
    enabled true
}
